{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"]
		},
		"codegen": {
			"cache": false,
			"outputs": [".adonisjs/**"]
		},
		"typecheck": {
			"dependsOn": ["codegen"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"with": ["worker"]
		},
		"worker": {
			"cache": false,
			"persistent": true
		}
	}
}
