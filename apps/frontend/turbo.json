{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
			"env": ["VITE_*"]
		},
		"typecheck": {
			"dependsOn": ["@workspace/backend#codegen"],
			"cache": false
		},
		"test": {
			"env": ["CI"]
		},
		"test:unit": {
			"env": ["CI"]
		},
		"test:unit:watch": {
			"cache": false,
			"persistent": true
		}
	}
}
