# Server Config
NODE_ENV=development
TZ=UTC
PORT=3333
HOST=localhost
APP_URL=https://api.examples.localhost
LOG_LEVEL=info
APP_KEY=

# Frontend Config
FRONTEND_URL=https://frontend.examples.localhost

# Session Config
SESSION_DRIVER=cookie

# Database Config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=e5_development

# Mail Config
MAIL_MAILER=browser
MAIL_FROM_NAME=E5 Stack
MAIL_FROM_ADDRESS=noreply@e5-stack.com

# Redis Config
REDIS_CONNECTION=main
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiter Config
LIMITER_STORE=redis

# Queue Config
QUEUE_DRIVER=redis

# Drive Config
DRIVE_DRIVER=fs

# Sentry Config
SENTRY_ENABLED=false
SENTRY_DSN=https://ingest.de.sentry.io
SENTRY_ENV=development

# GitHub OAuth Config
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder