{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"root": false,
	"extends": "//",
	"linter": {
		"domains": {
			"react": "recommended",
			"tailwind": "recommended"
		},
		"rules": {
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"tailwind": { "mergeFunctions": ["cn"], "variantFunctions": ["tv"] }
}
